        "duration_seconds": 600,
        "thumbnail_url": "https://cdn.app.com/thumbs/cnt_001.jpg",
        "audio_url": "https://cdn.app.com/audio/cnt_001.mp3",
        "tags": ["stress", "beginner", "guided", "morning"],
        "is_premium": false,
        "difficulty": "beginner",
        "created_at": "2026-03-15T10:00:00Z"
      },
      "types": ["meditation", "sleep_story", "soundscape", "breathwork", "video", "focus_music"],
      "difficulties": ["beginner", "intermediate", "advanced"]
    },

    "category": {
      "_description": "Groups content into browsable buckets. A content item belongs to one primary category but can appear in multiple via tags.",
      "example": {
        "id": "cat_stress",
        "name": "Stress & Anxiety",
        "slug": "stress-anxiety",
        "icon": "wind",
        "color": "#F47D20",
        "description": "Techniques to manage stress and find your calm.",
        "content_count": 48,
        "sort_order": 1
      }
    },

    "collection": {
      "_description": "Curated playlists or programs. Can be editorial (staff picks), algorithmic (for you), or structured (21-day program).",
      "example": {
        "id": "col_001",
        "title": "CBT for Anxiety & Depression",
        "description": "A structured mix of mindfulness activities and practices used in therapy, proven to help you feel better.",
        "type": "program",
        "thumbnail_url": "https://cdn.app.com/collections/cbt.jpg",
        "gradient_colors": ["#FF6496", "#FF9664"],
        "content_ids": ["cnt_001", "cnt_002", "cnt_003"],
        "total_sessions": 21,
        "estimated_daily_minutes": 10,
        "is_premium": true
      },
      "types": ["program", "playlist", "editorial", "daily_picks"]
