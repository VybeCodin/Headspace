    "user_progress": {
      "_description": "Tracks what a user has listened to, how far they got, and when. Powers 'continue listening', stats, and streaks.",
      "example": {
        "id": "prg_001",
        "user_id": "usr_001",
        "content_id": "cnt_001",
        "status": "completed",
        "progress_seconds": 600,
