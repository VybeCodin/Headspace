  "_readme": "Headspace App — Frontend Data Model v1. Dummy data for all tabs. Designed for future API mapping.",

  "core_entities": {

    "content": {
      "_description": "The central entity. Every meditation, sleep story, video, or soundscape is a 'content' item. This is the single source of truth that all tabs reference.",
      "example": {
        "id": "cnt_001",
        "title": "Finding Calm in Chaos",
        "description": "A 10-minute guided meditation to help you find stillness when life feels overwhelming.",
        "type": "meditation",
        "category_id": "cat_stress",
        "instructor": {
          "id": "ins_001",
          "name": "Sarah Mitchell",
          "avatar_url": "https://cdn.app.com/instructors/sarah.jpg"
